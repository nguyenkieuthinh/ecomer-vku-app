rules_version = '2';

// ============================================================================
// SECURITY RULES — HỆ THỐNG NHẬP LIỆU SẢN PHẨM
//
// Cách dùng: Firebase Console → Firestore Database → Rules → dán toàn bộ
// nội dung file này → Publish.
// Hoặc: firebase deploy --only firestore:rules
//
// Cấu trúc:
//   products/{id}        : tenSanPham, loaiSanPham, gia, image (ĐÚNG 4 trường)
//   product_images/{id}  : productId, tieuDe, data (base64), tenFile, order
//   product_owners/{id}  : userId, userEmail — chủ sở hữu sản phẩm
//   counters/{slug}      : bộ đếm sinh id sản phẩm
//   users/{uid}          : hồ sơ người dùng + role
//
// QUYỀN:
//   - Mọi tài khoản đã đăng nhập: XEM tất cả sản phẩm (của mình và người khác).
//   - user thường: thêm sản phẩm; chỉ sửa/xoá sản phẩm do mình nhập.
//   - admin: thêm/sửa/xoá TẤT CẢ sản phẩm.
//   Admin xác định bằng email trong token (khớp User.ADMIN_EMAILS trong code).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in [
          'admin@ecomer.vn'
        ];
    }

    // Người đang đăng nhập có phải chủ sản phẩm không.
    function ownerOf(productId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/product_owners/$(productId))
        && get(/databases/$(database)/documents/product_owners/$(productId))
             .data.userId == request.auth.uid;
    }

    // ------------------------------------------------------- Sản phẩm
    // Chỉ người đã đăng nhập mới đọc được.
    // Ai đăng nhập cũng thêm được; sửa/xoá chỉ chủ sở hữu hoặc admin.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || ownerOf(productId);
    }

    // -------------------------------------------------------- Ảnh sản phẩm
    // Mỗi ảnh một document riêng nên giới hạn 1 MiB áp dụng cho từng ảnh.
    // Quyền theo chủ sở hữu của sản phẩm chứa ảnh.
    match /product_images/{imageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (isAdmin() || ownerOf(request.resource.data.productId));
      allow update, delete: if isAdmin()
        || (isSignedIn() && ownerOf(resource.data.productId));
    }

    // --------------------------------------------------- Chủ sở hữu sản phẩm
    // Lưu riêng để document sản phẩm chỉ có đúng 4 trường như đề yêu cầu.
    match /product_owners/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // --------------------------------------------- Bộ đếm sinh id sản phẩm
    // Người dùng thường cũng cần ghi bộ đếm khi thêm sản phẩm.
    match /counters/{typeSlug} {
      allow read, write: if isSignedIn();
    }

    // ----------------------------------------------------- Hồ sơ người dùng
    // Người dùng đọc/sửa hồ sơ của chính mình.
    // KHÔNG ai tự đặt role "admin": role mới phải giống role cũ,
    // riêng admin mới đổi được.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == 'user';

      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
          && request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }
  }
}
